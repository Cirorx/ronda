rules_version = '2';

// Deny by default. Blurred-photo uploads open their own path with face blur.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // A voice note for the extract callable: only the owner writes it, only
    // after users/{uid}.terms exists (the tap on a welcome door), only a WAV
    // of at most 3 MB (60 s of 16 kHz mono 16-bit is ~1.9 MB). The callable
    // deletes it once read; the owner may delete it after a failed read.
    // Nobody reads it back from a client.
    match /audio/{uid}/{noteId} {
      allow create: if request.auth != null && request.auth.uid == uid
          && noteId.matches('[A-Za-z0-9_-]{1,64}[.]wav')
          && request.resource.contentType == 'audio/wav'
          && request.resource.size <= 3 * 1024 * 1024
          && firestore.exists(/databases/(default)/documents/users/$(uid))
          && 'terms' in firestore.get(/databases/(default)/documents/users/$(uid)).data;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // A photo for the "Un mate de más" flyer, every face already pixelated
    // on the phone (packages/face_blur): only the owner writes it, a JPEG of
    // at most 3 MB (the phone sends 1600 px, well under 1 MB). The
    // make_mate_flyer callable checks that they host the ronda and deletes
    // it once read; the owner may delete it after a failed call. Nobody reads
    // it back from a client.
    match /flyer_photos/{uid}/{photoId} {
      allow create: if request.auth != null && request.auth.uid == uid
          && photoId.matches('[A-Za-z0-9_-]{1,64}[.]jpg')
          && request.resource.contentType == 'image/jpeg'
          && request.resource.size <= 3 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The flyer make_mate_flyer drew, read by the host who made it. Only the
    // callable writes it.
    match /flyers/{uid}/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}

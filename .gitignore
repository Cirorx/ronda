# --- Ronda: secrets, private data and local notes (keep at the top) ---
.env
.env.*
*.keystore
google-services.json
GoogleService-Info.plist
firebase-debug.log
firebase-debug.*.log
*-debug.log
# generated by `flutterfire configure`; CI copies tool/firebase_options_stub.dart
/lib/firebase_options*.dart
ios/firebase_app_id_file.json
# FCM's web service worker carries the web config inline; tool/firebase_messaging_sw.dart writes it
/web/firebase-messaging-sw.js
# the web build scripts/build_web.sh stages for Hosting, and the release builds' debug symbols
/hosting/app/
/symbols/
# Cloud Functions (Python)
functions/venv/
.firebase/
/build/
.dart_tool/
.DS_Store
# never commit pilot data
/data/private/
# local-only notes (its own local git repo, never on GitHub)
/notes/
# Python (solver)
solver/.venv/
__pycache__/
.pytest_cache/
.coverage


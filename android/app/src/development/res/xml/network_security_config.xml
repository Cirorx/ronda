<?xml version="1.0" encoding="utf-8"?>
<!-- Development flavor only: the Firebase emulators speak plain HTTP on the
     Mac. 10.0.2.2 is the Android emulator's alias for it; a USB phone reaches
     it on 127.0.0.1 after `adb reverse`. Production keeps Android's default
     (no cleartext anywhere). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

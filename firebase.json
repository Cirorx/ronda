{
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting",
    "predeploy": ["scripts/build_web.sh"],
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/api/f/**",
        "function": {
          "functionId": "flyer_landing",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/f/**",
        "destination": "/f/index.html"
      }
    ],
    "headers": [
      {
        "source": "/app/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "ignore": [
        "venv",
        ".git",
        "__pycache__",
        ".pytest_cache",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "tests",
        "pyproject.toml",
        "requirements-dev.txt",
        ".ruff_cache"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8088
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "pubsub": {
      "port": 8085
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}

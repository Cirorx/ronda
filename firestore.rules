rules_version = '2';

// Deny by default. Each collection opens only what docs/ARCHITECTURE.md
// § Data model says its readers need; anything not matched here is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Needs, mood and audio never reach the server (split by sensitivity).
    function carriesNoSensitiveFields() {
      return !request.resource.data.keys().hasAny(['needs', 'mood', 'audio']);
    }

    // A member reads and writes only their own profile. Subcollections
    // (private/eligible, tokens) are not matched here, so they stay closed
    // until their own rules are written.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && carriesNoSensitiveFields();
    }
  }
}

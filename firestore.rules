rules_version = '2';

// Deny by default. Each collection opens only what docs/ARCHITECTURE.md
// § Data model says its readers need; anything not matched here is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The owner, by the custom claim scripts/set_admin.py sets.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Needs, mood and audio never reach the server (split by sensitivity).
    function carriesNoSensitiveFields() {
      return !request.resource.data.keys().hasAny(['needs', 'mood', 'audio']);
    }

    // Rules can't loop over a list, but they can join it: a list of ids
    // joins into one string that `pattern` matches comma by comma. A map
    // can't be joined, so no field (a need, a mood, an audio path) rides
    // inside a list element under a key of its own.
    function isIdList(values, pattern) {
      return values is list
          && values.join(',').matches('(' + pattern + '(,' + pattern + ')*)?');
    }

    // The ids the app stores: `termo`, `futbol5`, `solymar-norte`.
    function idPattern() {
      return '[a-z][a-z0-9-]*';
    }

    // `{day}-{band}`, as in `tue-afternoon`.
    function slotPattern() {
      return '(mon|tue|wed|thu|fri|sat|sun)-(morning|afternoon|evening)';
    }

    // A member reads and writes only their own profile. Subcollections are
    // not matched here: private/eligible and tokens have their own blocks
    // below, and any other stays closed.
    //
    // Only the fields docs/ARCHITECTURE.md § Data model names, each optional
    // (the terms arrive first, when a welcome door is tapped; the profile
    // when onboarding is saved) and typed where it is cheap to check.
    match /users/{uid} {
      function isOptional(data, field, check) {
        return !(field in data) || check;
      }

      function isUserDocument(data) {
        return data.keys().hasOnly([
              'firstName', 'ageBand', 'barrio', 'slots', 'pretexts', 'brings',
              'plusOneUid', 'buddyUid', 'terms', 'createdAt'])
          && isOptional(data, 'firstName', data.firstName is string
              && data.firstName.size() > 0 && data.firstName.size() <= 30)
          && isOptional(data, 'ageBand', data.ageBand in [
              '18-29', '30-39', '40-49', '50-59', '60-69', '70-79', '80+'])
          && isOptional(data, 'barrio', data.barrio is string)
          && isOptional(data, 'slots', isIdList(data.slots, slotPattern()))
          && isOptional(data, 'pretexts', isIdList(data.pretexts, idPattern()))
          && isOptional(data, 'brings', isIdList(data.brings, idPattern()))
          && isOptional(data, 'plusOneUid', data.plusOneUid is string)
          && isOptional(data, 'buddyUid', data.buddyUid is string)
          && isOptional(data, 'terms', data.terms is map
              && data.terms.keys().hasOnly(['version', 'acceptedAt'])
              && data.terms.version is string
              && data.terms.acceptedAt is timestamp)
          && isOptional(data, 'createdAt', data.createdAt is timestamp);
      }

      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && carriesNoSensitiveFields()
          && isUserDocument(request.resource.data);
    }

    // Seat facts the server publishes for the phone's needs filter, one per
    // seat id. Written by the admin SDK only.
    match /seat_facts/{seatId} {
      allow read: if request.auth != null;
    }

    // The seat ids that passed the member's needs on their phone, and when:
    // exactly seatIds and updatedAt. Nobody reads it back from a client; the
    // solver reads it with the admin SDK.
    match /users/{uid}/private/eligible {
      allow create, update: if isOwner(uid) && isEligibleSeatIds();
    }

    // Each id is a seat id, `{barrio}_{pretext}_{slot}`; the size bound
    // stays above every possible seat (9 barrios x 4 pretexts x 21 slots =
    // 756).
    function isEligibleSeatIds() {
      let data = request.resource.data;
      return data.keys().hasOnly(['seatIds', 'updatedAt'])
          && data.keys().hasAll(['seatIds', 'updatedAt'])
          && data.seatIds is list
          && data.seatIds.size() <= 1000
          && isIdList(data.seatIds,
              idPattern() + '_' + idPattern() + '_' + slotPattern())
          && data.updatedAt == request.time;
    }

    // The solver's groups waiting for approval: the admin reads them, nobody
    // else, so nothing reaches a member before Aprobar. The propose_groups
    // and approve_proposal callables write them with the admin SDK.
    match /proposals/{proposalId} {
      allow read: if isAdmin();
    }

    // An approved ronda and its member list, read by its own members only.
    // approve_proposal writes both with the admin SDK.
    function isMemberOf(rondaId) {
      return request.auth != null && exists(
          /databases/$(database)/documents/rondas/$(rondaId)/members/$(request.auth.uid));
    }

    match /rondas/{rondaId} {
      allow read: if isMemberOf(rondaId);

      match /members/{uid} {
        allow read: if isMemberOf(rondaId);
      }
    }

    // The member's phones for push, one document per FCM token: exactly the
    // platform and when it was saved, by the owner only. No client reads a
    // token back; the sender reads them with the admin SDK.
    match /users/{uid}/tokens/{token} {
      allow create, update: if isOwner(uid) && isDeviceToken();
      allow delete: if isOwner(uid);
    }

    function isDeviceToken() {
      let data = request.resource.data;
      return data.keys().hasOnly(['platform', 'updatedAt'])
          && data.keys().hasAll(['platform', 'updatedAt'])
          && data.platform in ['android', 'ios', 'web']
          && data.updatedAt == request.time;
    }

    // Cerca tuyo's counts, one document per barrio: rondas by pretext, slot,
    // age range and seats, and how many neighbours wait. No uid, name or place
    // (functions/cerca_tuyo.py). Anyone may get one, signed in or not; nobody
    // lists them or writes them from a client. The refresh_cerca function
    // writes them with the admin SDK. Tear-off `flyers/{id}` stay closed: the
    // flyer_landing function counts scans and answers the QR page instead.
    match /cerca/{barrio} {
      allow get: if true;
    }

    // "Un mate de más" flyers (docs/ARCHITECTURE.md § Data model), kind
    // `mate`: read by the host who made one and by that ronda's hosts, never
    // listed. Only the make_mate_flyer callable writes them, with the admin
    // SDK. Tear-off flyers (kind `tearOff`) are not opened here.
    match /flyers/{flyerId} {
      allow get: if request.auth != null
          && resource.data.kind == 'mate'
          && (resource.data.createdBy == request.auth.uid
              || isRondaHost(resource.data.rondaId));
    }

    // Whether the caller is ronda [rondaId]'s anfitrión or cola.
    function isRondaHost(rondaId) {
      let hosts = get(/databases/$(database)/documents/rondas/$(rondaId))
          .data.get('hosts', {});
      return request.auth.uid in [hosts.get('anfitrion', ''), hosts.get('cola', '')];
    }

    // The weekly loop (#45). The raw `rsvp` map lives in rondas/{id}/weeks/{isoWeek}, which no
    // client reads (nothing matches it). Members read the derived "who's coming" view of their
    // own ronda, and each member only their own answer. The answer_rsvp callable and the RSVP
    // job write all three with the admin SDK; no client writes any of them.
    match /rondas/{rondaId}/views/{view} {
      allow read: if isMemberOf(rondaId);
    }

    match /rondas/{rondaId}/answers/{uid} {
      allow read: if isOwner(uid) && isMemberOf(rondaId);
    }

    // The rondas a member is in, so their phone finds theirs: one document per ronda,
    // written by approve_proposal and read by that member only.
    match /users/{uid}/rondas/{rondaId} {
      allow read: if isOwner(uid);
    }
  }
}

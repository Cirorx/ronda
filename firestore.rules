rules_version = '2';

// Deny by default. Each collection opens only what docs/ARCHITECTURE.md
// § Data model says its readers need; anything not matched here is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Needs, mood and audio never reach the server (split by sensitivity).
    function carriesNoSensitiveFields() {
      return !request.resource.data.keys().hasAny(['needs', 'mood', 'audio']);
    }

    // A member reads and writes only their own profile. Subcollections are
    // not matched here: private/eligible has its own block below, and any
    // other (tokens) stays closed until its rules are written.
    //
    // Only the fields docs/ARCHITECTURE.md § Data model names, each optional
    // (the terms arrive first, when a welcome door is tapped; the profile
    // when onboarding is saved) and typed where it is cheap to check.
    match /users/{uid} {
      function isOptional(data, field, check) {
        return !(field in data) || check;
      }

      function isUserDocument(data) {
        return data.keys().hasOnly([
              'firstName', 'ageBand', 'barrio', 'slots', 'pretexts', 'brings',
              'plusOneUid', 'buddyUid', 'terms', 'createdAt'])
          && isOptional(data, 'firstName', data.firstName is string
              && data.firstName.size() > 0 && data.firstName.size() <= 30)
          && isOptional(data, 'ageBand', data.ageBand in [
              '18-29', '30-39', '40-49', '50-59', '60-69', '70-79', '80+'])
          && isOptional(data, 'barrio', data.barrio is string)
          && isOptional(data, 'slots', data.slots is list)
          && isOptional(data, 'pretexts', data.pretexts is list)
          && isOptional(data, 'brings', data.brings is list)
          && isOptional(data, 'plusOneUid', data.plusOneUid is string)
          && isOptional(data, 'buddyUid', data.buddyUid is string)
          && isOptional(data, 'terms', data.terms is map
              && data.terms.keys().hasOnly(['version', 'acceptedAt'])
              && data.terms.version is string
              && data.terms.acceptedAt is timestamp)
          && isOptional(data, 'createdAt', data.createdAt is timestamp);
      }

      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && carriesNoSensitiveFields()
          && isUserDocument(request.resource.data);
    }

    // Seat facts the server publishes for the phone's needs filter, one per
    // seat id. Written by the admin SDK only.
    match /seat_facts/{seatId} {
      allow read: if request.auth != null;
    }

    // The seat ids that passed the member's needs on their phone, and when:
    // exactly seatIds and updatedAt. Nobody reads it back from a client; the
    // solver reads it with the admin SDK.
    match /users/{uid}/private/eligible {
      allow create, update: if isOwner(uid) && isEligibleSeatIds();
    }

    // Rules can't check each element's type, so "a list of seat id strings"
    // is the client's half; the size bound stays above every possible seat
    // (9 barrios x 4 pretexts x 21 slots = 756).
    function isEligibleSeatIds() {
      let data = request.resource.data;
      return data.keys().hasOnly(['seatIds', 'updatedAt'])
          && data.keys().hasAll(['seatIds', 'updatedAt'])
          && data.seatIds is list
          && data.seatIds.size() <= 1000
          && data.updatedAt == request.time;
    }
  }
}
